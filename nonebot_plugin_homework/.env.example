COMMAND_START=["/"]
HOMEWORK_BINDING_SECRET=replace-with-the-secret-from-admin-settings

# 管理后台填写可访问的完整 URL（包含此路径），并设置相同的通知 Secret。
# 留空 Secret 时不启用通知路由；启用时需要 ASGI 驱动器，例如 ~fastapi。
HOMEWORK_NOTIFICATION_PATH=/homework/notifications
HOMEWORK_NOTIFICATION_SECRET=
HOMEWORK_NOTIFICATION_BOT_ID=

# Bot 可访问的平台后台根地址，结尾不带 /，不要填写 /admin 或 /api。
# 留空时不启用 QQ 引用回复；凭据复用上面的 HOMEWORK_NOTIFICATION_SECRET。
HOMEWORK_PLATFORM_URL=
