# Export these variables before running the backend, or use Docker Compose.
PORT=8080
DATA_DIR=./data
DB_DRIVER=sqlite
# Optional. SQLite defaults to DATA_DIR/homework.db
# DB_DSN=./data/homework.db
# For mysql/postgres without DB_DSN, a missing database will be created:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_NAME=homework
# DB_SSLMODE=disable
# DB_DSN takes precedence. For MySQL/PostgreSQL the account needs CREATE DATABASE permission if the database is absent.
# JWT_SECRET=at-least-32-random-characters-for-sessions
# Initial value only; subsequent updates are made in admin settings.
# BINDING_SECRET=at-least-32-random-characters-shared-with-bot
# Set true behind HTTPS in production.
COOKIE_SECURE=false
